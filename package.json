{
  "name": "takecare",
  "version": "1.0.0",
  "private": true,
  "description": "TakeCare — AI-assisted medicine inventory and replenishment platform",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:up": "sh scripts/db-up.sh",
    "db:seed": "npm --prefix server run db:seed",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:reset": "npm --prefix server run db:reset",
    "db:studio": "npm --prefix server run db:studio",
    "dev": "sh scripts/dev.sh",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start:server": "npm --prefix server run start"
  }
}
