# PostgreSQL connection string (local Docker default)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://takecare:takecare_dev_password@localhost:5433/takecare"

# Secret used to sign JWTs. Generate a long random value in production.
JWT_SECRET="replace-with-a-long-random-secret"

# API server port
PORT=3001

# Frontend origin allowed by CORS
CLIENT_ORIGIN="http://localhost:3000"

NODE_ENV=development

# Gnani Prisma v2.5 speech-to-text. Server-side only; never expose this key.
GNANI_API_KEY=""
