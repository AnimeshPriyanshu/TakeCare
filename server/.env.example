# PostgreSQL connection string
DATABASE_URL="postgresql://takecare:takecare_dev_password@localhost:5433/takecare"

# Secret used to sign JWTs. Generate a long random value in production.
JWT_SECRET="replace-with-a-long-random-secret"

# API server port
PORT=3001

# Frontend origin allowed by CORS
CLIENT_ORIGIN="http://localhost:3000"

NODE_ENV=development

# Optional live AI provider. Leave empty to use the built-in demo assistant.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
